#include <windows.h>
#include "version.h"
101 ICON "assets/batteryscope.ico"
// Pixel UI font: subset of Cubic 11 (SIL OFL 1.1, see assets/pixel-ui-OFL.txt).
102 RCDATA "assets/pixel-ui.ttf"
// Power lab test page, served to the browser during the automatic test.
103 RCDATA "assets/labtest.html"
1 RT_MANIFEST "app.manifest"
1 VERSIONINFO
FILEVERSION BS_VERSION_MAJOR,BS_VERSION_MINOR,BS_VERSION_PATCH,0
PRODUCTVERSION BS_VERSION_MAJOR,BS_VERSION_MINOR,BS_VERSION_PATCH,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "BatteryScope - Native battery monitor\0"
      VALUE "FileVersion", BS_VERSION_STRING
      VALUE "ProductName", "BatteryScope\0"
      VALUE "ProductVersion", BS_VERSION_STRING
      VALUE "OriginalFilename", "BatteryScope.exe\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
